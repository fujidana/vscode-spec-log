// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "compile",
			"detail": "Run tsc, eslint, and esbuild",
			"icon": {
				"id": "tools"
			},
			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": [
				"$tsc",
				"$eslint-stylish",
				"$esbuild"
			]
		},
		{
			"label": "watch",
			"detail": "Watch tsc and esbuild",
			"icon": {
				"id": "tools"
			},
			"dependsOn": [
				"npm: watch:tsc",
				"npm: watch:esbuild"
			],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch for tests",
			"detail": "Watch tsc and esbuild for tests",
			"icon": {
				"id": "tools"
			},
			"dependsOn": [
				"npm: watch:esbuild",
				"npm: watch-tests"
			],
			"problemMatcher": []
		},
		{
			"label": "npm: watch:esbuild",
			"type": "npm",
			"script": "watch:esbuild",
			"group": "build",
			"problemMatcher": "$esbuild-watch",
			"isBackground": true,
			"presentation": {
				"group": "watchers",
				"reveal": "never"
			}
		},
		{
			"label": "npm: watch:tsc",
			"type": "npm",
			"script": "watch:tsc",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"group": "watchers",
				"reveal": "never"
			}
		},
		{
			"type": "npm",
			"script": "watch-tests",
			"group": "build",
			"presentation": {
				"group": "watchers",
				"reveal": "never"
			},
			"isBackground": true,
			"problemMatcher": "$tsc-watch"
		},
		{
			"label": "test",
			"detail": "vscode-test",
			"icon": {
				"id": "beaker"
			},
			"type": "npm",
			"script": "test",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "test-web",
			"detail": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/extensionTests.js",
			"icon": {
				"id": "beaker"
			},
			"type": "npm",
			"script": "test-web",
			"group": "test",
			"problemMatcher": []
		}
	]
}